{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      "**/*.md"
    ]
  },
  "tasks": {
    "check": "deno check shared/*.ts variant-a/*.ts variant-b/*.ts",
    "test": "deno test shared/*_test.ts variant-a/*_test.ts",
    "fmt": "deno fmt",
    "compile:thin": "deno compile -o out/variant-a.exe variant-a/main_a.ts",
    "compile:ink": "deno compile --allow-env=NODE_ENV,TERM_PROGRAM,TERM,TMUX,CI,CONTINUOUS_INTEGRATION,TF_BUILD,DEV,INK_SCREEN_READER,COLUMNS --allow-sys=osRelease -o out/variant-b.exe variant-b/main_b.ts"
  }
}
