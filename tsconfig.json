{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "paths": {
      "@std/assert": ["./testing/asserts.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "testing/**/*.ts"]
}
